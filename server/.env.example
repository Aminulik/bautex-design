PORT=3003
FRONTEND_ORIGIN=http://localhost:3001
JWT_SECRET=replace_me_with_a_long_random_secret

# Optional: create admin user on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_me

# Optional integrations
TAVILY_API_KEY=
REPLICATE_API_TOKEN=
CLIPDROP_API_KEY=

# Optional wall segmentation service. Expected response: image/png mask
# or JSON with {"maskBase64":"..."} where white pixels are wall area.
# Local diploma-friendly default after starting `npm run ml:start`.
SEGFORMER_API_URL=http://localhost:8000/segment/wall
SEGFORMER_API_TOKEN=

