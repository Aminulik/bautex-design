{
  "name": "bautex-design",
  "homepage": "https://github.com/Aminulik/bautex-design",
  "version": "1.0.0",
  "main": "src/index.tsx",
  "scripts": {
    "start": "webpack serve --mode=development --config webpack.config.mjs",
    "build": "webpack --mode=production --config webpack.config.mjs",
    "dev": "webpack --mode=development --watch --config webpack.config.mjs",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js src",
    "doctor": "node scripts_ГОСТ/doctor.mjs",
    "smoke": "node scripts_ГОСТ/doctor.mjs --smoke",
    "server:start": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "ml:install": "python -m pip install -r ml_service/requirements.txt",
    "ml:start": "python -m uvicorn app:app --host 0.0.0.0 --port 8000 --app-dir ml_service",
    "ml:evaluate": "python ml_service/evaluate_segmentation.py --service http://localhost:8000 --dataset test_data/segmentation",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "demo:up": "docker compose up --build",
    "demo:down": "docker compose down"
  },
